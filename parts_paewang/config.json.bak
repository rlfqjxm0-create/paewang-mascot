  "ctile": true,
  "game_talk": [
    "잘하셨어요.",
    "조용히, 그러나 확실했어요.",
    "그 한 수, 마음에 들어요.",
    "멈추지 않으셨네요.",
    "한 판 잘 마치셨어요.",
    "꼬리 아홉이 다 박수 쳐요.",
    "훌륭했어요."
  ],
  "game_talk_win": [
    "전부 지우셨네요. 훌륭합니다.",
    "한 장도 남기지 않으셨어요.",
    "이런 건 오래 기억에 남아요."
  ],
  "g2_talk": {
    "start": [
      "오늘도 조용히 가 볼까요.",
      "한 수에 마음 하나.",
      "여우는 기다릴 줄 알아요.",
      "천천히 시작해요."
    ],
    "move_none": [
      "그 길은 막혀 있어요.",
      "괜찮아요. 다른 길이 있어요.",
      "잠시 멈춰도 돼요.",
      "서두르지 않아도 돼요."
    ],
    "big": [
      "그 한 수, 마음에 들어요.",
      "조용히, 그러나 확실했어요.",
      "잘하고 있어요.",
      "제법 커졌네요."
    ],
    "combo": [
      "한 번에 셋이네요.",
      "꼬리 세 개가 움직였어요.",
      "훌륭한 수였어요.",
      "조용한 큰 수였어요."
    ],
    "top": [
      "최고 기록이에요.",
      "여기까지 오셨네요.",
      "꼬리 아홉이 박수 쳐요.",
      "잘하고 있어요, 정말로."
    ],
    "tight": [
      "자리가 좁아졌어요.",
      "숨 한 번 쉬고 두세요.",
      "여우는 궁지에서 침착해요.",
      "한 수만 잘 보면 돼요."
    ],
    "idle": [
      "기다릴게요. 천천히요.",
      "급할 것 없어요.",
      "생각도 한 수예요.",
      "조용히 지켜볼게요."
    ],
    "near": [
      "1024까지 오셨네요.",
      "마지막 한 수예요.",
      "여기서 멈추지 마세요.",
      "마음 하나만 더요."
    ],
    "win": [
      "2048이에요. 훌륭했어요.",
      "끝내 해내셨네요.",
      "꼬리 아홉이 다 박수 쳐요.",
      "오늘의 한 수, 최고였어요."
    ],
    "over": [
      "여기까지 잘 오셨어요.",
      "멈추지 않으셨네요.",
